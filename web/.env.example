# Server-side Next.js rewrite destination. Never exposed to browser bundles.
ORCA_BACKEND_URL=http://127.0.0.1:8000

# Optional only when FastAPI is intentionally exposed directly to browsers.
# Keep blank to use same-origin /api through Next.js.
NEXT_PUBLIC_ORCA_API_URL=

# Optional direct WebSocket endpoint. If blank, chat attempts same-origin WS and
# falls back to the authenticated/ordinary HTTP chat route when unavailable.
NEXT_PUBLIC_ORCA_WS_URL=
