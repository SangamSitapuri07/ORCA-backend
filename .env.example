# ORCA Box / FastAPI
ORCA_DEBUG=0
ORCA_DEMO_MODE=0
ORCA_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ORCA_CORS_ORIGIN_REGEX=

# Optional provider credentials. Leave blank to disable those providers.
GFW_API_TOKEN=
MOSDAC_USERNAME=
MOSDAC_PASSWORD=

# Local Ollama explanation service. Deterministic safety does not depend on it.
OLLAMA_ENABLED=auto
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_S=25

# Network-heavy cache warming is opt-in to avoid surprise quota use.
ORCA_WARMUP=0
ORCA_PREWARM=0
ORCA_PREWARM_GFW_PINS=0
